{
  "name": "piece-drop-to-cdn",
  "version": "0.1.0",
  "description": "Activepieces piece for Drop to CDN — upload files and get instant public CDN URLs",
  "license": "MIT",
  "homepage": "https://droptocdn.com/integrations/activepieces",
  "keywords": [
    "activepieces",
    "activepieces-piece",
    "droptocdn",
    "cdn",
    "file-upload"
  ],
  "author": {
    "name": "Drop to CDN",
    "email": "support@droptocdn.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nexus-JPF/piece-drop-to-cdn.git"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && cp -R src/i18n dist/src/",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@activepieces/pieces-common": "0.12.5",
    "@activepieces/pieces-framework": "0.32.0",
    "@activepieces/shared": "^0.95.1",
    "form-data": "4.0.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tslib": "2.6.2",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
